# --- Cloudinary (optional unless you use super-admin Cloudinary avatars) ---
# Required only for: POST /api/upload/cloudinary/profile-image and DELETE …/cloudinary/profile-image
# (super_admin profile in admin UI). Other image uploads use local disk (uploads/).
# Dashboard → Product environment credentials (no quotes, no spaces around =).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Folder layout in Media Library: <CLOUDINARY_PROJECT_FOLDER>/<CLOUDINARY_PROFILE_SUBFOLDER>/user_<mongoUserId>
# Defaults if unset: spireleap / profile  →  public_id prefix "spireleap/profile/user_<id>"
CLOUDINARY_PROJECT_FOLDER=spireleap
CLOUDINARY_PROFILE_SUBFOLDER=profile

# Legacy: if you set only this (and leave the two above unset), it is used as the full prefix instead:
# CLOUDINARY_PROFILE_FOLDER=spireleap/profiles

# Disk uploads (no Cloudinary): property/property-images, profile-image (agent/staff/admin non-super),
# POST /api/upload?folder=agencies|cms|footer|…, property-documents, lead-documents.
