# Cloudinary (super-admin profile: POST/DELETE /api/upload/cloudinary/profile-image)
# Dashboard → Product environment credentials (no quotes, no spaces around =).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Folder layout in Media Library: <CLOUDINARY_PROJECT_FOLDER>/<CLOUDINARY_PROFILE_SUBFOLDER>/user_<mongoUserId>
# Defaults if unset: spireleap / profile  →  public_id prefix "spireleap/profile/user_<id>"
CLOUDINARY_PROJECT_FOLDER=spireleap
CLOUDINARY_PROFILE_SUBFOLDER=profile

# Legacy: if you set only this (and leave the two above unset), it is used as the full prefix instead:
# CLOUDINARY_PROFILE_FOLDER=spireleap/profiles
